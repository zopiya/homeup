# Global variables available to all dotfile templates.
sourceDir = "{{ .chezmoi.sourceDir }}"

[data]
    # Identity is opt-in so a public image or fresh Codespace never inherits
    # personal Git data. Set HOMEUP_GIT_* before `just user::apply`.
    git_name = {{ env "HOMEUP_GIT_NAME" | quote }}
    git_email = {{ env "HOMEUP_GIT_EMAIL" | quote }}
    git_signing_key = {{ env "HOMEUP_GIT_SIGNING_KEY" | quote }}
    git_sign_commits = {{ env "HOMEUP_GIT_SIGN_COMMITS" | quote }}

[edit]
    command = "nvim"

[diff]
    command = "delta"
    pager = "delta"

[merge]
    command = "nvim"
    args = ["-d", "{{ `{{ .Destination }}` }}", "{{ `{{ .Source }}` }}", "{{ `{{ .Target }}` }}"]

[update]
    apply = false
