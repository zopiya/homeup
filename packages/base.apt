# Packages required by every Debian/Ubuntu carrier that has system access.
# Keep language runtimes and version-sensitive CLI tools out of this list.
ca-certificates
curl
git
zsh
sudo
# Locked runtimes are prebuilt archives (see toolchain/lock.sh) and never
# compiled on the target machine. These headers/toolchain packages are kept
# only so the user's own workflows (e.g. `pip install` of native extensions,
# `cargo` crates with C dependencies) work without a separate apt step.
build-essential
pkg-config
libssl-dev
zlib1g-dev
libbz2-dev
libreadline-dev
libsqlite3-dev
libffi-dev
liblzma-dev
libncursesw5-dev
libgdbm-dev
libnss3-dev
libuuid1
tk-dev
unzip
xz-utils
tar
gzip
jq
shellcheck
shfmt
tmux
ncurses-term
direnv
fzf
gnupg
ripgrep
fd-find
bat
htop
ncdu
rsync
mosh
sysstat
lsof
glances
bmon
lnav
ansible
mtr
dnsutils
netcat-openbsd
tcpdump
rclone
