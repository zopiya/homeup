set shell := ["bash", "-uc"]

SCRIPTS_DIR := source_directory()

# ── System (Day 0, root) ─────────────────────────────────────────────────────

# Create sudo user + install SSH key + passwordless sudo
@create-user:
    echo "→ Creating sudo user..."
    sudo -E bash "{{SCRIPTS_DIR}}/system/create-user.sh"

# Configure ufw firewall
@ufw:
    echo "→ Configuring firewall (ufw)..."
    sudo -E bash "{{SCRIPTS_DIR}}/system/ufw.sh"

# Set hostname
@hostname:
    echo "→ Setting hostname..."
    sudo -E bash "{{SCRIPTS_DIR}}/system/hostname.sh"

# Set timezone
@timezone:
    echo "→ Setting timezone..."
    sudo -E bash "{{SCRIPTS_DIR}}/system/timezone.sh"

# Disable root/password SSH login (never automatic — run manually after confirming login)
@ssh-harden:
    echo "→ SSH hardening (irreversible — read the prompts carefully)..."
    sudo -E bash "{{SCRIPTS_DIR}}/system/ssh-harden.sh"

# ── Packages (Day 1) ─────────────────────────────────────────────────────────

# Install apt packages from the flat package list
@apt:
    echo "→ Installing apt packages..."
    sudo apt-get update -qq
    grep -v '^#' "{{SCRIPTS_DIR}}/packages/apt-packages.txt" | xargs sudo apt-get install -y

# Deprecated compatibility alias for locked core CLI installation.
@tools:
    echo "→ Installing locked core CLI tools..."
    bash "{{SCRIPTS_DIR}}/packages/install-tools.sh"
