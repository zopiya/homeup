set shell := ["bash", "-uc"]

SCRIPTS_DIR := source_directory()

# ── System (Day 0, root) ─────────────────────────────────────────────────────

# Create sudo user + install SSH key + passwordless sudo
create-user:
    sudo bash "{{SCRIPTS_DIR}}/system/create-user.sh"

# Configure ufw firewall
ufw:
    sudo bash "{{SCRIPTS_DIR}}/system/ufw.sh"

# Set hostname
hostname:
    sudo bash "{{SCRIPTS_DIR}}/system/hostname.sh"

# Set timezone
timezone:
    sudo bash "{{SCRIPTS_DIR}}/system/timezone.sh"

# Disable root/password SSH login (never automatic — run manually after confirming login)
ssh-harden:
    sudo bash "{{SCRIPTS_DIR}}/system/ssh-harden.sh"

# ── Packages (Day 1) ─────────────────────────────────────────────────────────

# Install apt packages from the flat package list
apt:
    sudo apt-get update -qq
    xargs -a "{{SCRIPTS_DIR}}/packages/apt-packages.txt" sudo apt-get install -y

# Install upstream tools apt lacks/undershoots
tools:
    bash "{{SCRIPTS_DIR}}/packages/install-tools.sh"
